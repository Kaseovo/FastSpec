			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "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",
				"GITHUB_TOOLSETS": "",
