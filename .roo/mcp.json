				"GITHUB_READ_ONLY",
				"ghcr.io/github/github-mcp-server"
			],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "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",
				"GITHUB_TOOLSETS": "",
