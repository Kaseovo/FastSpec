# FastSpec configuration — copy to .env and adjust.
#
# Everything is optional: with no configuration at all, FastSpec runs in
# single-user mode with SQLite (see docs/SELF_HOSTING.md).

# ── Public URL ───────────────────────────────────────────────────────────────
# Where people reach FastSpec, without a trailing slash. Used to build the
# sign-in redirect URI ({PUBLIC_URL}/auth/oidc/callback) and as the default
# CORS origin.
# PUBLIC_URL=http://localhost:8080

# ── Sign-in ──────────────────────────────────────────────────────────────────
# none : single user, no sign-in. Anyone who can reach the server has full
#        access — keep it on localhost or a trusted network.
# oidc : sign in with any OpenID Connect provider (Google, Keycloak,
#        Authentik, Okta, Microsoft Entra, GitLab, …).
# AUTH_MODE=none

# Required when AUTH_MODE=oidc. The server refuses to start if these are set
# while AUTH_MODE=none, so a forgotten AUTH_MODE never leaves it open.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Button label ("Sign in with …"). Defaults to "Google" for Google, else "SSO".
# OIDC_PROVIDER_NAME=
# OIDC_SCOPES=openid email profile

# Optional allowlist (AUTH_MODE=oidc only), comma-separated. Without one, any
# account at the provider can sign in — with Google, that's any Google user.
# ALLOWED_EMAIL_DOMAINS=example.com
# ALLOWED_EMAILS=alice@example.com,bob@example.org

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory for the SQLite database and the generated JWT secret. The Docker
# image sets this to /data (mount a volume there).
# FASTSPEC_DATA_DIR=./.data

# Use Postgres instead of SQLite (recommended for teams).
# DATABASE_URL=postgresql://fastspec:fastspec@localhost:5432/fastspec

# ── Secrets & tokens ─────────────────────────────────────────────────────────
# Signs sessions and API-key tokens. Generated and stored in FASTSPEC_DATA_DIR
# when unset; set it explicitly when running several instances.
# Generate one with: openssl rand -hex 32
# JWT_SECRET_KEY=
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# API_KEY_TTL_DAYS=30
# SHORT_JWT_TTL_SECONDS=300

# ── Source code (AGPL-3.0) ───────────────────────────────────────────────────
# Linked from the app so people using this instance can get its source. If
# you run a modified FastSpec for others, point this at your changes.
# SOURCE_URL=https://github.com/Kaseovo/FastSpec

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=8080
# WEB_CONCURRENCY=1
# Comma-separated proxy IPs trusted for X-Forwarded-* headers.
# FORWARDED_ALLOW_IPS=127.0.0.1
# CORS_ORIGINS=https://fastspec.example.com
