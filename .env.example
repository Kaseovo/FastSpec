# FastAPI Backend Configuration

# Python settings
PYTHONUNBUFFERED=1

# Database (PostgreSQL)
DATABASE_URL=postgresql://fastspec:fastspec@postgres:5432/fastspec

# Server settings
HOST=0.0.0.0
PORT=8000

# JWT Configuration - CHANGE IN PRODUCTION!
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
# Access token expiry in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=3600
# Short JWT (issued via refresh exchange)
SHORT_JWT_TTL_SECONDS=300

# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# OAuth2 - Google
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# OAuth2 - GitHub
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost/auth/github/callback

# Frontend URL
FRONTEND_URL=http://localhost/specs

# CORS Origins
CORS_ORIGINS=http://localhost

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
